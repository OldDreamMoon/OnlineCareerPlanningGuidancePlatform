# 本地开发统一环境变量入口（示例）
PROJECT_NAME=bishe
APP_ENV=dev
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=postgres
SERVER_DB_TARGET=postgres

# PostgreSQL
DB_URL=jdbc:postgresql://127.0.0.1:5432/bishe
DB_USERNAME=bishe
DB_PASSWORD=bishe

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO
MINIO_ENABLED=true
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=bishe-assets

# Frontend
VITE_APP_NAME=bishe-web
VITE_API_BASE_URL=/api/v1

# Auth / admin
JWT_SECRET=bishe-auth-secret-key-with-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
ADMIN_INIT_EMAIL=admin@bishe.local
ADMIN_INIT_PASSWORD=Passw0rd!
ADMIN_INIT_DISPLAY_NAME=系统管理员

# Notification
NOTIFICATION_APP_BASE_URL=http://127.0.0.1:5173
NOTIFICATION_DISPATCH_BATCH_SIZE=8
NOTIFICATION_DISPATCH_LEASE_MS=30000
NOTIFICATION_DISPATCH_POLL_INTERVAL_MS=2000
NOTIFICATION_DISPATCH_RETENTION_ENABLED=true
NOTIFICATION_DISPATCH_RETENTION_MAX_AGE_MS=2592000000
NOTIFICATION_DISPATCH_RETENTION_BATCH_SIZE=200
NOTIFICATION_DISPATCH_RETENTION_INITIAL_DELAY_MS=3600000
NOTIFICATION_DISPATCH_RETENTION_FIXED_DELAY_MS=3600000
NOTIFICATION_WS_TICKET_TTL_SECONDS=180
NOTIFICATION_EMAIL_RESEND_API_KEY=
NOTIFICATION_EMAIL_RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL_RESEND_API_URL=https://api.resend.com/emails

# AI gateway defaults (Java internal AI module)
AI_GATEWAY_MODE=ROUTED
AI_GATEWAY_CONFIG_SECRET=change_me_with_32_chars
AI_GATEWAY_ALLOW_LEGACY_FALLBACK=false
AI_GATEWAY_DEBUG_ENABLED=false
AI_GATEWAY_AI_REQUEST_LOG_ENABLED=false
AI_INTERVIEW_MAX_REPLY_ROUNDS=30
AI_INTERVIEW_RESERVED_QUOTA_WEIGHT=5
AI_TTS_CACHE_ENABLED=true
AI_TTS_CACHE_TTL_SECONDS=1800
AI_PROVIDER_KEY=openai-compatible
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=gpt-4o-mini
AI_PROVIDER_STT_MODEL=gpt-4o-mini
AI_PROVIDER_TTS_MODEL=
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_COST_PER_1K_INPUT=0
AI_PROVIDER_COST_PER_1K_OUTPUT=0
AI_PROVIDER_TEMPERATURE=0.2

# Gemini Live bridge
GEMINI_API_KEY=
INTERVIEW_LIVE_MODEL=gemini-3.1-flash-live-preview
INTERVIEW_LIVE_VOICE=Kore
INTERVIEW_LIVE_HOST=127.0.0.1
INTERVIEW_LIVE_PORT=8765
INTERVIEW_LIVE_WS_PATH=/ai/interview/live/ws
INTERVIEW_LIVE_HEALTH_PATH=/ai/interview/live/healthz
INTERVIEW_LIVE_THINKING_LEVEL=minimal
INTERVIEW_LIVE_THINKING_BUDGET=0
INTERVIEW_LIVE_VAD_PREFIX_PADDING_MS=20
INTERVIEW_LIVE_VAD_SILENCE_DURATION_MS=180
INTERVIEW_LIVE_COMPRESSION_TRIGGER_TOKENS=24000
INTERVIEW_LIVE_COMPRESSION_TARGET_TOKENS=12000
INTERVIEW_LIVE_SESSION_RESUMPTION=true
INTERVIEW_LIVE_LOG_LEVEL=INFO

# Geetest v4 captcha (optional)
AUTH_CAPTCHA_GEETEST_ENABLED=false
AUTH_CAPTCHA_GEETEST_CAPTCHA_ID=
AUTH_CAPTCHA_GEETEST_CAPTCHA_KEY=
AUTH_CAPTCHA_GEETEST_VERIFY_URL=https://gcaptcha4.geetest.com/validate
AUTH_CAPTCHA_GEETEST_TIMEOUT_MS=5000
AUTH_CAPTCHA_GEETEST_PROOF_TTL_SECONDS=600

# Resend email verification (optional)
AUTH_EMAIL_RESEND_API_KEY=
AUTH_EMAIL_RESEND_FROM_EMAIL=
AUTH_EMAIL_RESEND_API_URL=https://api.resend.com/emails
AUTH_EMAIL_CODE_TTL_SECONDS=600
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
AUTH_EMAIL_PROOF_TTL_SECONDS=1800

# 本地答辩演示模式：仅建议本地运行时开启，不要用于正式部署
# 开启后会放宽找回密码、认证注册上传/审核等本地演示阻塞点；
# 注册邮箱验证码是否跳过，仍由下方独立开关控制。
DEMO_MODE_ENABLED=false
DEMO_AUTH_REGISTER_SKIP_EMAIL_VERIFICATION=false
DEMO_AUTH_FIXED_EMAIL_CODE=000000

# Certification upload
CERTIFICATION_MAX_FILE_SIZE_BYTES=10485760

# Alipay sandbox (optional)
PAYMENT_MODE=MOCK
PAYMENT_UNPAID_TIMEOUT_MINUTES=30
PAYMENT_SANDBOX_PAY_BASE_URL=
PAYMENT_SANDBOX_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
PAYMENT_SANDBOX_APP_ID=
PAYMENT_SANDBOX_APP_PRIVATE_KEY=
PAYMENT_SANDBOX_APP_PRIVATE_KEY_BASE64=
PAYMENT_SANDBOX_APP_PRIVATE_KEY_PATH=
PAYMENT_SANDBOX_ALIPAY_PUBLIC_KEY=
PAYMENT_SANDBOX_ALIPAY_PUBLIC_KEY_BASE64=
PAYMENT_SANDBOX_ALIPAY_PUBLIC_KEY_PATH=
PAYMENT_SANDBOX_NOTIFY_URL=
PAYMENT_SANDBOX_RETURN_URL=http://127.0.0.1:5173/consult/orders/{orderNo}
PAYMENT_SANDBOX_VERIFY_ENABLED=true
PAYMENT_SANDBOX_SIGN_TYPE=RSA2
PAYMENT_SANDBOX_CHARSET=utf-8
PAYMENT_SANDBOX_SUBJECT_PREFIX=职业规划咨询
PAYMENT_SANDBOX_TIMEOUT_EXPRESS=30m
PAYMENT_SANDBOX_PRODUCT_CODE=FAST_INSTANT_TRADE_PAY

# Consult / recommendation workers
CONSULT_MENTOR_REPLY_TIMEOUT_HOURS=24
CONSULT_MENTOR_REPLY_RECLAIM_FIXED_DELAY_MS=60000
MENTOR_RECOMMENDATION_RETENTION_ENABLED=true
MENTOR_RECOMMENDATION_RETENTION_MAX_AGE_MS=2592000000
MENTOR_RECOMMENDATION_RETENTION_BATCH_SIZE=500
MENTOR_RECOMMENDATION_RETENTION_INITIAL_DELAY_MS=3600000
MENTOR_RECOMMENDATION_RETENTION_FIXED_DELAY_MS=3600000

# 历史 MySQL 迁移/备份工具（仅供 scripts/db/* 使用，不参与当前默认运行链）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=bishe
MYSQL_USER=bishe
MYSQL_PASSWORD=bishe